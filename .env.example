# Environment Variables Template
# Copy ini ke .env.local dan isi dengan nilai real
# JANGAN PUSH .env.local ke Git!

# ====================================
# SUPABASE CONFIGURATION
# ====================================
# Get dari: https://supabase.com/dashboard → Settings → API

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (untuk client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (untuk server-side ONLY)
# ⚠️ KEEP THIS SECRET - DO NOT SHARE!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ====================================
# EMAIL SERVICE (Optional)
# ====================================
# Untuk email notifications

# SendGrid API Key
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Resend API Key (alternative)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email sender address
NEXT_PUBLIC_SENDER_EMAIL=noreply@smanegeri1.sch.id

# ====================================
# ANALYTICS (Optional)
# ====================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN (error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ====================================
# APP CONFIGURATION
# ====================================

# App Environment
NEXT_PUBLIC_APP_ENV=development
# production, staging, development

# App URL (for redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ====================================
# SCHOOL INFORMATION (Optional)
# ====================================

NEXT_PUBLIC_SCHOOL_NAME=SMA Negeri 1
NEXT_PUBLIC_SCHOOL_EMAIL=info@smanegeri1.sch.id
NEXT_PUBLIC_SCHOOL_PHONE=+62-xxx-xxxxxx
NEXT_PUBLIC_SCHOOL_ADDRESS=Jln. Pendidikan No. 1
NEXT_PUBLIC_SCHOOL_CITY=Kota
NEXT_PUBLIC_SCHOOL_PROVINCE=Provinsi

# ====================================
# FEATURE FLAGS (Optional)
# ====================================

# Enable/Disable features
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_MULTILANG=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ====================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ====================================

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ReCAPTCHA Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lcl...

# ReCAPTCHA Secret Key (server-side)
RECAPTCHA_SECRET_KEY=6Lcl...

# ====================================
# PAYMENT GATEWAY (Optional - untuk PPDB)
# ====================================

# Midtrans (payment gateway)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Client-key-xxx
MIDTRANS_SERVER_KEY=Server-key-xxx

# ====================================
# DATABASE (Direct - jika tidak pakai Supabase)
# ====================================

# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ====================================
# DEPLOYMENT & MONITORING (Production)
# ====================================

# Vercel Environment
VERCEL_ENV=development
VERCEL_URL=localhost:3000

# ====================================
# NOTES
# ====================================
# 1. Copy ini ke .env.local (local development)
# 2. Untuk production, set variables di Vercel Dashboard
# 3. NEVER commit .env.local ke Git
# 4. Public variables dimulai dengan NEXT_PUBLIC_
# 5. Server-side variables TIDAK dimulai dengan NEXT_PUBLIC_
# 6. Reload dev server jika mengubah .env.local
